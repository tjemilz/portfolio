# ==============================================================================
# STILL24 PORTFOLIO - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables before running in production.
# Command: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# Set DEBUG=False in production. Never run with DEBUG=True in production!
DEBUG=False

# Generate a strong, unique secret key for production:
# Command: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Comma-separated list of host/domain names that this Django site can serve.
# In Docker with Nginx, include localhost, 127.0.0.1, backend, and your public domains.
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1,backend,still24.fr,api.still24.fr

# Comma-separated list of origins authorized to make cross-site HTTP requests.
CORS_ALLOWED_ORIGINS=https://still24.fr,http://localhost:3000,http://localhost

# ------------------------------------------------------------------------------
# 2. SECURITY & COOKIE SETTINGS
# ------------------------------------------------------------------------------
# Set to True in production (HTTPS). Set to False for local testing over HTTP.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS settings (Recommended for production HTTPS with Cloudflare or direct SSL)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Access token validity in minutes (default: 60)
JWT_ACCESS_TOKEN_LIFETIME=60
# Refresh token validity in minutes (default: 1440 = 24h)
JWT_REFRESH_TOKEN_LIFETIME=1440

# ------------------------------------------------------------------------------
# 4. BRUTE FORCE PROTECTION (DJANGO-AXES)
# ------------------------------------------------------------------------------
# Number of consecutive login failures allowed before lockout
AXES_FAILURE_LIMIT=5
# Lockout cooldown period in minutes
AXES_COOLOFF_MINUTES=15

# ------------------------------------------------------------------------------
# 5. SECURITY NOTIFICATIONS (NTFY)
# ------------------------------------------------------------------------------
# Set NTFY_ENABLED=True to receive real-time push alerts on login attempts
NTFY_ENABLED=False
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC_SUCCESS=still24-login-success-changeme
NTFY_TOPIC_FAILED=still24-login-failed-changeme
# Optional: Bearer token for private/authenticated ntfy topics
# NTFY_AUTH_TOKEN=your-ntfy-access-token

# ------------------------------------------------------------------------------
# 6. FRONTEND NEXT.JS (App Router)
# ------------------------------------------------------------------------------
# In production with Nginx reverse proxy, leave NEXT_PUBLIC_API_URL empty
# so API calls route relatively to the same origin (/api/...)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MEDIA_URL=/media
