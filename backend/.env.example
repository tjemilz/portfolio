# ==============================================================================
# STILL24 DJANGO BACKEND - STANDALONE ENVIRONMENT TEMPLATE
# ==============================================================================
# Use this when running the Django backend directly via python/venv without Docker.
# ==============================================================================

DEBUG=True
SECRET_KEY=django-insecure-dev-only-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookies: False for local HTTP, True for production HTTPS
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Media paths (relative to backend/)
MEDIA_URL=/media/
MEDIA_ROOT=media

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Ntfy Security Notifications
NTFY_ENABLED=False
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC_SUCCESS=still24-login-success-changeme
NTFY_TOPIC_FAILED=still24-login-failed-changeme

# Brute force protection
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
